model Book {
  id String @id @default(cuid())
  title String @unique 
  description String
  price Float @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  authorId String 

  likes Int @default(0)
  views Int @default(0)

  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)
  notes Note[]
}